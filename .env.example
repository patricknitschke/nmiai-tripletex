# LLM Provider: "anthropic" or "vertex"
LLM_PROVIDER=vertex
# Model name (e.g. claude-sonnet-4-6, gemini-2.0-flash)
LLM_MODEL=gemini-2.0-flash

# Anthropic (for competition — best accuracy)
ANTHROPIC_API_KEY=sk-ant-...

# Vertex AI (for testing + production on Cloud Run — uses GCP auth, no API key needed)
GCP_PROJECT_ID=your-project-id
GCP_LOCATION=europe-north1

# Tripletex sandbox (for local testing only — competition provides its own credentials)
TRIPLETEX_BASE_URL=https://your-sandbox.tripletex.dev/v2
TRIPLETEX_SESSION_TOKEN=your-session-token-here
